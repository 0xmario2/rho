<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="dark" />
<link rel="icon" href="data:," />
<title>RHO — Memes. Meet $RHO.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Manrope:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#070708; --bg2:#0d0e10; --panel:#121316; --panel2:#17181c;
    --ink:#f6f6f3; --muted:#a3a3ab; --faint:#6d6d75;
    --orange:#ff5a1f; --orange-soft:#ff7a45; --navy:#1b2f6e; --navy-deep:#101d47;
    --line:rgba(255,255,255,.10); --line2:rgba(255,255,255,.18);
    --radius:20px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:"Manrope",system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  button,[role="button"],select,summary,input:not([type="checkbox"],[type="radio"]){min-height:2.25rem}
  button{font-family:inherit;cursor:pointer}
  a{color:inherit}
  img{display:block;max-width:100%}
  .mono{font-family:"Space Mono",monospace}
  .disp{font-family:"Bricolage Grotesque","Manrope",sans-serif}

  /* ---------- LOADER ---------- */
  #loader{position:fixed;inset:0;z-index:200;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;transition:opacity .5s ease,visibility .5s}
  #loader.done{opacity:0;visibility:hidden}
  .loader-loop{width:74px;height:74px;animation:bounce 0.9s cubic-bezier(.28,.84,.42,1) infinite alternate}
  @keyframes bounce{from{transform:translateY(0) scale(1,1)}to{transform:translateY(-26px) scale(.96,1.04)}}
  #loader p{letter-spacing:.35em;font-size:13px;color:var(--muted);margin:0;text-indent:.35em}
  .loader-shadow{width:56px;height:10px;border-radius:50%;background:rgba(255,255,255,.14);animation:sh 0.9s cubic-bezier(.28,.84,.42,1) infinite alternate}
  @keyframes sh{from{transform:scaleX(1);opacity:.7}to{transform:scaleX(.6);opacity:.35}}

  /* ---------- NAV ---------- */
  header{position:fixed;top:0;left:0;right:0;z-index:100;background:linear-gradient(180deg,rgba(7,7,8,.92),rgba(7,7,8,.75) 70%,transparent);backdrop-filter:blur(8px)}
  .nav{max-width:1180px;margin:0 auto;padding:12px 16px;display:flex;align-items:center;gap:10px}
  .logo{display:flex;align-items:center;gap:9px;text-decoration:none;margin-right:auto}
  .logo-mark{width:38px;height:38px;border-radius:12px;background:var(--orange);display:grid;place-items:center;flex:none}
  .logo-mark svg{width:24px;height:24px}
  .logo-text{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:24px;letter-spacing:.01em;line-height:1}
  .logo-text sup{color:var(--orange);font-size:15px}
  .nav-btn{border-radius:999px;padding:9px 18px;font-family:"Space Mono",monospace;font-weight:700;font-size:13px;letter-spacing:.06em;text-decoration:none;border:1.5px solid transparent;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
  .nav-btn.pfp{border-color:var(--orange);color:var(--orange);background:transparent}
  .nav-btn.join{border-color:var(--line2);color:var(--ink);background:transparent}
  .nav-btn.buy{background:var(--orange);color:#14080a;border-color:var(--orange)}
  .nav-btn:active{transform:scale(.97)}
  @media(max-width:560px){ .nav{padding:10px 12px;gap:7px} .nav-btn{padding:8px 13px;font-size:12px} .logo-text{font-size:21px} }

  /* ---------- HERO ---------- */
  .hero{position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;text-align:center;padding:118px 20px 0;overflow:hidden;background:radial-gradient(1100px 520px at 50% -8%,#1a2040 0%,var(--bg) 58%)}
  .stars{position:absolute;inset:0;pointer-events:none}
  .stars i{position:absolute;background:#fff;border-radius:50%;opacity:.75;animation:tw 3.2s ease-in-out infinite alternate}
  @keyframes tw{from{opacity:.15}to{opacity:.85}}
  .hero-word{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(88px,19vw,196px);line-height:.92;letter-spacing:-.01em;color:var(--orange);position:relative;z-index:2}
  .hero-word sup{font-size:.34em;vertical-align:super;color:var(--orange-soft)}
  .hero-tag{font-family:"Bricolage Grotesque",sans-serif;font-weight:600;font-size:clamp(21px,4.6vw,34px);margin:10px 0 0;position:relative;z-index:2}
  .hero-sub{color:var(--muted);font-size:clamp(14px,2.6vw,17px);margin:12px auto 0;max-width:480px;line-height:1.55;position:relative;z-index:2}
  .hero-sea{position:relative;width:100%;flex:1;display:flex;align-items:flex-end;justify-content:center;margin-top:8px;min-height:280px}
  .hero-sea::before{content:"";position:absolute;left:50%;transform:translateX(-50%);bottom:0;width:min(860px,120%);height:46%;background:radial-gradient(60% 100% at 50% 0%,#232a52 0%,#0b0e1e 70%,transparent);border-radius:50% 50% 0 0/100% 100% 0 0;opacity:.9}
  .ripple{position:absolute;left:50%;bottom:16%;transform:translateX(-50%);border:1.5px dashed rgba(255,255,255,.28);border-radius:50%;pointer-events:none}
  .ripple.r1{width:340px;height:64px}.ripple.r2{width:520px;height:96px;opacity:.55}.ripple.r3{width:720px;height:132px;opacity:.3}
  .hero-mascot{position:relative;z-index:3;-webkit-mask-image:radial-gradient(ellipse 72% 68% at 50% 50%,#000 58%,transparent 79%);mask-image:radial-gradient(ellipse 72% 68% at 50% 50%,#000 58%,transparent 79%);width:min(400px,74vw);margin-bottom:-6px;filter:drop-shadow(0 24px 44px rgba(0,0,0,.55));animation:floaty 4.5s ease-in-out infinite}
  @keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  .scroll-cue{position:relative;z-index:4;display:flex;flex-direction:column;align-items:center;gap:2px;padding:14px 0 26px;color:var(--ink)}
  .scroll-cue .lbl{font-family:"Space Mono",monospace;letter-spacing:.4em;font-size:12px;text-indent:.4em}
  .scroll-cue svg{animation:cue 1.4s ease-in-out infinite}
  @keyframes cue{0%,100%{transform:translateY(0);opacity:.9}50%{transform:translateY(6px);opacity:.4}}

  /* ---------- SCROLLY ZOOM ---------- */
  .scrolly{position:relative;height:260vh;background:var(--bg)}
  .scrolly-stick{position:sticky;top:0;height:100svh;overflow:hidden;display:flex;align-items:center;justify-content:center;background:radial-gradient(800px 480px at 50% 110%,#1a2040 0%,var(--bg) 60%)}
  .scrolly-face{width:min(620px,96vw);-webkit-mask-image:radial-gradient(ellipse 72% 68% at 50% 50%,#000 58%,transparent 79%);mask-image:radial-gradient(ellipse 72% 68% at 50% 50%,#000 58%,transparent 79%);will-change:transform;filter:drop-shadow(0 30px 60px rgba(0,0,0,.6))}
  .scrolly-line{position:absolute;left:0;right:0;bottom:9%;text-align:center;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(26px,6vw,46px);padding:0 22px;opacity:0;transform:translateY(14px);transition:opacity .25s,transform .25s;text-shadow:0 4px 30px rgba(0,0,0,.8)}
  .scrolly-line.on{opacity:1;transform:none}
  .scrolly-line em{color:var(--orange);font-style:normal}

  /* ---------- MARQUEE ---------- */
  .marquee{background:var(--orange);color:#160806;overflow:hidden;padding:11px 0;border-block:2px solid #160806}
  .marquee-track{display:flex;gap:0;width:max-content;animation:mq 22s linear infinite;font-family:"Space Mono",monospace;font-weight:700;font-size:14px;letter-spacing:.12em;white-space:nowrap}
  @keyframes mq{to{transform:translateX(-50%)}}

  /* ---------- SECTIONS ---------- */
  section.block{max-width:1060px;margin:0 auto;padding:84px 20px 8px}
  .kicker{font-family:"Space Mono",monospace;font-size:12px;letter-spacing:.32em;color:var(--orange);text-transform:uppercase;margin:0 0 14px}
  h2.title{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(32px,6.4vw,54px);line-height:1.04;margin:0 0 14px}
  .lead{color:var(--muted);font-size:clamp(15px,2.6vw,18px);line-height:1.65;max-width:640px;margin:0}
  .lead b{color:var(--ink)}
  .lead a{color:var(--orange)}

  /* points */
  .points-head{display:flex;flex-wrap:wrap;gap:18px;align-items:stretch;margin-top:30px}
  .score-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;min-width:210px;flex:0 1 auto}
  .score-num{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:56px;line-height:1;color:var(--orange)}
  .score-lbl{color:var(--muted);font-size:13px;margin-top:4px}
  .score-bar{height:8px;background:#232428;border-radius:99px;margin-top:14px;overflow:hidden;width:190px;max-width:100%}
  .score-fill{height:100%;width:0%;background:var(--orange);border-radius:99px;transition:width .5s cubic-bezier(.2,.8,.3,1)}
  .score-note{flex:1 1 260px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;color:var(--muted);font-size:14.5px;line-height:1.6}
  .score-note b{color:var(--ink)}
  .tasks{margin-top:18px;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
  .task{display:flex;align-items:center;gap:14px;padding:18px 20px;background:var(--panel);border-bottom:1px solid var(--line);text-align:left;width:100%;color:var(--ink);border-top:0;border-left:0;border-right:0;font-size:15px}
  .task:last-child{border-bottom:0}
  .task:hover{background:var(--panel2)}
  .task .t-main{flex:1;min-width:0}
  .task .t-name{font-weight:800;font-size:16.5px;display:block}
  .task .t-desc{color:var(--muted);font-size:13.5px;display:block;margin-top:2px;line-height:1.45}
  .task .t-pts{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:22px;color:var(--orange);white-space:nowrap}
  .task .t-state{font-family:"Space Mono",monospace;font-weight:700;font-size:12px;letter-spacing:.05em;border:1.5px solid var(--line2);border-radius:999px;padding:8px 14px;white-space:nowrap;min-width:86px;text-align:center}
  .task.done .t-state{background:var(--orange);border-color:var(--orange);color:#160806}
  .task.done .t-name{color:var(--muted);text-decoration:line-through;text-decoration-color:var(--orange);text-decoration-thickness:2px}

  /* builders shared */
  .builder{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px;align-items:start}
  @media(max-width:760px){.builder{grid-template-columns:1fr}}
  .stage{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px}
  .stage-canvas{border-radius:14px;overflow:hidden;position:relative}
  .controls{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px}
  .controls h3{margin:0 0 6px;font-family:"Bricolage Grotesque",sans-serif;font-size:20px;font-weight:800}
  .controls p{color:var(--muted);font-size:13.5px;line-height:1.55;margin:0 0 16px}
  .swatches{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}
  .swatch{width:44px;height:44px;border-radius:50%;border:2.5px solid transparent;padding:0;flex:none}
  .swatch.sel{border-color:#fff;box-shadow:0 0 0 3px var(--orange)}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;padding:12px 22px;font-weight:800;font-size:14.5px;border:1.5px solid var(--line2);background:transparent;color:var(--ink);text-decoration:none}
  .btn.orange{background:var(--orange);border-color:var(--orange);color:#160806}
  .btn:active{transform:scale(.97)}
  .btn-row{display:flex;gap:10px;flex-wrap:wrap}
  .cap-input{width:100%;background:#0a0a0c;border:1px solid var(--line2);border-radius:12px;color:var(--ink);padding:12px 14px;font-size:15px;font-weight:700;margin-bottom:10px;font-family:inherit}
  .cap-input::placeholder{color:var(--faint);font-weight:500}
  .meme-stage{position:relative;background:#000}
  .meme-stage img{width:100%}
  .meme-cap{position:absolute;left:0;right:0;text-align:center;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;text-transform:uppercase;color:#fff;font-size:clamp(20px,5.4vw,34px);line-height:1.12;padding:0 14px;text-shadow:2px 2px 0 #000,-2px 2px 0 #000,2px -2px 0 #000,-2px -2px 0 #000,0 4px 14px rgba(0,0,0,.7);pointer-events:none;word-break:break-word}
  .meme-cap.top{top:12px}.meme-cap.bot{bottom:12px}
  #pfpStage{aspect-ratio:1/1;padding:16px;transition:background .3s}
  #pfpStage img{width:100%;height:100%;object-fit:cover;border-radius:14px}

  /* brand kit */
  .brand-grid{display:grid;grid-template-columns:340px 1fr;gap:20px;margin-top:30px;align-items:stretch}
  @media(max-width:760px){.brand-grid{grid-template-columns:1fr}}
  .logo-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:26px;display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
  .logo-big{display:flex;align-items:center;gap:12px}
  .logo-big .logo-mark{width:64px;height:64px;border-radius:18px}
  .logo-big .logo-mark svg{width:40px;height:40px}
  .logo-big .logo-text{font-size:44px}
  .logo-card p,.banner-card p{color:var(--muted);font-size:13.5px;line-height:1.55;margin:0}
  .banner-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px;display:flex;flex-direction:column;gap:14px}
  .banner-card img{border-radius:12px;width:100%}
  .card-foot{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .card-foot .sp{flex:1}
  .ratio-tag{font-family:"Space Mono",monospace;font-size:11.5px;color:var(--muted);border:1px solid var(--line2);border-radius:999px;padding:6px 12px}

  /* token strip */
  .token-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:30px}
  @media(max-width:760px){.token-strip{grid-template-columns:repeat(2,1fr)}}
  .tok{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px}
  .tok .v{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(20px,3.6vw,27px)}
  .tok .k{color:var(--muted);font-size:12.5px;margin-top:3px;line-height:1.4}
  .draft-note{color:var(--faint);font-size:12.5px;margin-top:12px}

  /* finale */
  .finale{position:relative;text-align:center;padding:110px 20px 30px;overflow:hidden;background:radial-gradient(900px 460px at 50% 118%,#1a2040 0%,var(--bg) 62%)}
  .finale-duo{display:flex;justify-content:center;align-items:flex-end;gap:0;margin-bottom:6px}
  .finale-duo img{width:min(190px,38vw);-webkit-mask-image:radial-gradient(ellipse 72% 68% at 50% 50%,#000 58%,transparent 79%);mask-image:radial-gradient(ellipse 72% 68% at 50% 50%,#000 58%,transparent 79%)}
  .finale-duo img.face{width:min(215px,44vw);margin-left:-34px}
  .finale h2{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:clamp(36px,7.4vw,62px);margin:8px 0 12px}
  .finale p{color:var(--muted);max-width:560px;margin:0 auto 26px;line-height:1.65;font-size:16px}
  .finale p a{color:var(--orange)}
  .finale-btns{display:flex;flex-direction:column;align-items:center;gap:11px}
  .finale-btns .row{display:flex;gap:11px;flex-wrap:wrap;justify-content:center}
  .fbtn{border-radius:999px;padding:14px 30px;font-family:"Space Mono",monospace;font-weight:700;font-size:14px;letter-spacing:.05em;text-decoration:none;border:1.5px solid var(--orange);display:inline-flex;align-items:center;justify-content:center}
  .fbtn.solid{background:var(--orange);color:#160806}
  .fbtn.ghost{background:transparent;color:var(--orange)}
  .fbtn.plain{border-color:var(--line2);color:var(--ink)}
  footer{padding:34px 20px 44px;text-align:center;color:var(--faint);font-size:13px;line-height:1.6}

  /* modal + toast */
  .modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:150;display:none;align-items:flex-end;justify-content:center;padding:0}
  .modal-bg.open{display:flex}
  .modal{background:var(--panel2);width:100%;max-width:520px;border-radius:24px 24px 0 0;padding:28px 24px calc(28px + env(safe-area-inset-bottom));border:1px solid var(--line2);border-bottom:0;text-align:center}
  @media(min-width:640px){.modal-bg{align-items:center;padding:20px}.modal{border-radius:24px;border-bottom:1px solid var(--line2)}}
  .modal img{width:110px;margin:0 auto 8px;border-radius:18px}
  .modal h3{font-family:"Bricolage Grotesque",sans-serif;font-size:26px;font-weight:800;margin:6px 0 8px}
  .modal p{color:var(--muted);line-height:1.6;margin:0 0 20px;font-size:15px}
  #toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,80px);background:var(--orange);color:#160806;font-weight:800;font-size:14.5px;border-radius:999px;padding:13px 24px;z-index:180;transition:transform .35s cubic-bezier(.2,.8,.3,1);box-shadow:0 14px 34px rgba(0,0,0,.5);max-width:92vw;text-align:center}
  #toast.show{transform:translate(-50%,0)}
  @media (prefers-reduced-motion: reduce){
    .hero-mascot,.scroll-cue svg,.loader-loop,.stars i{animation:none}
    html{scroll-behavior:auto}
  }
</style>
</head>
<body>

<!-- LOADER -->
<div id="loader" aria-hidden="true">
  <svg class="loader-loop" viewBox="0 0 100 100" fill="none"><circle cx="50" cy="36" r="24" stroke="#ff5a1f" stroke-width="13"/><path d="M50 60 L50 94" stroke="#ff5a1f" stroke-width="13" stroke-linecap="round"/></svg>
  <div class="loader-shadow"></div>
  <p class="mono">LOADING RHO…</p>
</div>

<!-- NAV -->
<header>
  <nav class="nav">
    <a class="logo" href="#top" aria-label="RHO home">
      <span class="logo-mark"><svg viewBox="0 0 100 100" fill="none"><circle cx="50" cy="36" r="23" stroke="#160806" stroke-width="14"/><path d="M50 59 L50 92" stroke="#160806" stroke-width="14" stroke-linecap="round"/></svg></span>
      <span class="logo-text">RHO<sup>ρ</sup></span>
    </a>
    <a class="nav-btn pfp" href="#pfp">PFP</a>
    <a class="nav-btn join" href="#join">JOIN</a>
    <button class="nav-btn buy" id="buyBtn" type="button">BUY $RHO</button>
  </nav>
</header>

<!-- HERO -->
<div class="hero" id="top">
  <div class="stars" id="stars1"></div>
  <div class="hero-word">RHO<sup>ρ</sup></div>
  <p class="hero-tag">Small loop. Big energy.</p>
  <p class="hero-sub">RHO is the blob with the loop — born on the timeline, raised by memes. No suits, no roadmap-speak. Just the loop, growing.</p>
  <div class="hero-sea">
    <span class="ripple r1"></span><span class="ripple r2"></span><span class="ripple r3"></span>
    <img class="hero-mascot" src="data:image/webp;base64," alt="RHO mascot — a glossy navy blob with an orange loop antenna shaped like the letter rho, arms raised" />
  </div>
  <div class="scroll-cue">
    <span class="lbl">SCROLL</span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 8 L12 16 L20 8" stroke="#f6f6f3" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 14 L12 22 L20 14" stroke="#f6f6f3" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity=".45" transform="translate(0,-3)"/></svg>
  </div>
</div>

<!-- SCROLLY ZOOM -->
<div class="scrolly" id="scrolly">
  <div class="scrolly-stick">
    <div class="stars" id="stars2"></div>
    <img class="scrolly-face" id="scrollyFace" src="data:image/webp;base64," alt="Close-up of the RHO mascot's surprised face, mouth wide open" />
    <div class="scrolly-line" data-line="0">He came from <em>the timeline.</em></div>
    <div class="scrolly-line" data-line="1">He eats <em>red candles</em> for breakfast.</div>
    <div class="scrolly-line" data-line="2">And he <em>never</em> leaves the loop.</div>
  </div>
</div>

<!-- MARQUEE -->
<div class="marquee" aria-hidden="true"><div class="marquee-track" id="mqTrack"></div></div>

<!-- EARLY POINTS -->
<section class="block" id="points">
  <p class="kicker">Early Points</p>
  <h2 class="title">Be early.<br/>Stack your points.</h2>
  <p class="lead">Before launch, the timeline is the game. Do the tasks, stack points, and your place in the loop is locked in when $RHO goes live.</p>

  <div class="points-head">
    <div class="score-card">
      <div class="score-num" id="scoreNum">0</div>
      <div class="score-lbl">approved points</div>
      <div class="score-bar"><div class="score-fill" id="scoreFill"></div></div>
    </div>
    <div class="score-note"><b>How it works:</b> tap a task to mark it done and claim its points. Follow &amp; post tasks open <b>@RHOfun</b> on X in a new tab — come back and tap again to confirm.</div>
  </div>

  <div class="tasks" id="taskList">
