<div id="toast" role="status"></div>

<script>
(function(){
  "use strict";
  var $ = function(s){ return document.querySelector(s); };

  /* loader */
  window.addEventListener("load", function(){
    setTimeout(function(){ $("#loader").classList.add("done"); }, 700);
  });
  setTimeout(function(){ $("#loader").classList.add("done"); }, 2600); /* safety */

  /* stars */
  function makeStars(id, n){
    var box = document.getElementById(id); if(!box) return;
    var html = "";
    for(var i=0;i<n;i++){
      var s = (Math.random()*2+1).toFixed(1);
      html += '<i style="left:'+(Math.random()*100)+'%;top:'+(Math.random()*100)+'%;width:'+s+'px;height:'+s+'px;animation-delay:'+(Math.random()*3)+'s"></i>';
    }
    box.innerHTML = html;
  }
  makeStars("stars1", 70); makeStars("stars2", 50); makeStars("stars3", 50);

  /* marquee */
  var chunk = " $RHO &nbsp;·&nbsp; MEMES. MEET $RHO. &nbsp;·&nbsp; SMALL LOOP. BIG ENERGY. &nbsp;·&nbsp; STAY IN THE LOOP &nbsp;·&nbsp;";
  $("#mqTrack").innerHTML = "<span>"+chunk.repeat(4)+"</span><span>"+chunk.repeat(4)+"</span>";

  /* scrolly zoom */
  var scrolly = $("#scrolly"), face = $("#scrollyFace"),
      lines = Array.prototype.slice.call(document.querySelectorAll(".scrolly-line")),
      reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function onScroll(){
    if(!scrolly) return;
    var r = scrolly.getBoundingClientRect();
    var total = r.height - window.innerHeight;
    var p = total > 0 ? Math.min(1, Math.max(0, -r.top/total)) : 0;
    var scale = reduced ? 1 : 0.55 + p*0.75;
    face.style.transform = "scale("+scale.toFixed(3)+")";
    var idx = p < 0.36 ? 0 : (p < 0.72 ? 1 : 2);
    lines.forEach(function(el,i){ el.classList.toggle("on", i===idx && p>0.04); });
  }
  window.addEventListener("scroll", onScroll, {passive:true});
  window.addEventListener("resize", onScroll);
  onScroll();

  /* toast */
  var toastTimer;
  function toast(msg){
    var t = $("#toast"); t.textContent = msg; t.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ t.classList.remove("show"); }, 2400);
  }

  /* points */
  var score = 0, MAX = 18, opened = {};
  var scoreNum = $("#scoreNum"), scoreFill = $("#scoreFill");
  function renderScore(){
    scoreNum.textContent = score;
    scoreFill.style.width = Math.round(score/MAX*100) + "%";
  }
  Array.prototype.forEach.call(document.querySelectorAll(".task"), function(btn){
    btn.addEventListener("click", function(){
      var pts = parseInt(btn.getAttribute("data-pts"),10);
      var link = btn.getAttribute("data-link");
      var key = btn.querySelector(".t-name").textContent;
      if(btn.classList.contains("done")){
        btn.classList.remove("done");
        btn.querySelector(".t-state").textContent = link ? "OPEN" : "CLAIM";
        score -= pts; renderScore();
        toast("Task removed — points updated.");
        return;
      }
      if(link && !opened[key]){
        opened[key] = true;
        window.open(link, "_blank", "noopener");
        btn.querySelector(".t-state").textContent = "CONFIRM";
        toast("Opened on X — tap again to confirm & claim +"+pts+".");
        return;
      }
      btn.classList.add("done");
      btn.querySelector(".t-state").textContent = "DONE ✓";
      score += pts; renderScore();
      toast("+"+pts+" points — you're in the loop.");
      if(score === MAX) setTimeout(function(){ toast("All tasks done. Full loop status: early legend."); }, 2600);
    });
  });
  renderScore();

  /* PFP builder */
  var pfpBg = "#ff5a1f";
  Array.prototype.forEach.call(document.querySelectorAll(".swatch"), function(sw){
    sw.addEventListener("click", function(){
      document.querySelectorAll(".swatch").forEach(function(x){ x.classList.remove("sel"); });
      sw.classList.add("sel");
      pfpBg = sw.getAttribute("data-bg");
      $("#pfpStage").style.background = pfpBg;
    });
  });
  function loadImg(src){
    return new Promise(function(res, rej){
      var im = new Image();
      im.onload = function(){ res(im); };
      im.onerror = rej;
      im.src = src;
    });
  }
  $("#pfpDownload").addEventListener("click", function(){
    loadImg("data:image/webp;base64,").then(function(im){
      var c = document.createElement("canvas"); c.width = 1024; c.height = 1024;
      var x = c.getContext("2d");
      x.fillStyle = pfpBg; x.fillRect(0,0,1024,1024);
      x.drawImage(im, 40, 40, 944, 944);
      var a = document.createElement("a");
      a.download = "rho-pfp.png"; a.href = c.toDataURL("image/png"); a.click();
      toast("PFP downloaded — wear the loop.");
    }).catch(function(){ toast("Couldn't build the PNG — screenshot the preview instead."); });
  });

  /* meme maker */
  var ideas = [
    ["WHEN THE DIP","KEEPS DIPPING"],
    ["ME CHECKING THE CHART","AT 3AM AGAIN"],
    ["HE SAID IT'S OVER","RHO SAID LOOP"],
    ["ONE MORE CANDLE","CAN'T HURT"],
    ["WHEN $RHO","ENTERS THE CHAT"],
    ["BOUGHT THE TOP","BECAME THE MEME"],
    ["THE LOOP SAW","EVERYTHING"]
  ];
  var ideaIdx = 0;
  var capTop = $("#capTop"), capBot = $("#capBot");
  function syncCaps(){
    $("#capTopPrev").textContent = capTop.value.toUpperCase();
    $("#capBotPrev").textContent = capBot.value.toUpperCase();
  }
  capTop.addEventListener("input", syncCaps);
  capBot.addEventListener("input", syncCaps);
  $("#shuffleBtn").addEventListener("click", function(){
    ideaIdx = (ideaIdx + 1 + Math.floor(Math.random()*(ideas.length-1))) % ideas.length;
    capTop.value = ideas[ideaIdx][0]; capBot.value = ideas[ideaIdx][1];
    syncCaps();
  });
  function drawCap(x, text, y, size){
    if(!text) return;
    x.font = "800 "+size+"px 'Bricolage Grotesque', sans-serif";
    x.textAlign = "center"; x.textBaseline = "middle";
    x.lineWidth = size/6; x.strokeStyle = "#000"; x.fillStyle = "#fff";
    x.strokeText(text, 512, y); x.fillText(text, 512, y);
  }
  $("#memeDownload").addEventListener("click", function(){
    loadImg("data:image/webp;base64,").then(function(im){
      var c = document.createElement("canvas"); c.width = 1024; c.height = 1024;
      var x = c.getContext("2d");
      x.drawImage(im, 0, 0, 1024, 1024);
      drawCap(x, capTop.value.toUpperCase(), 74, 62);
      drawCap(x, capBot.value.toUpperCase(), 950, 62);
      var a = document.createElement("a");
      a.download = "rho-meme.png"; a.href = c.toDataURL("image/png"); a.click();
      toast("Meme downloaded — post it with $RHO for +5 points.");
    }).catch(function(){ toast("Couldn't build the PNG — screenshot the preview instead."); });
  });

  /* buy modal */
  var modal = $("#buyModal");
  $("#buyBtn").addEventListener("click", function(){ modal.classList.add("open"); });
  $("#modalClose").addEventListener("click", function(){ modal.classList.remove("open"); });
  $("#modalPoints").addEventListener("click", function(){ modal.classList.remove("open"); });
  modal.addEventListener("click", function(e){ if(e.target === modal) modal.classList.remove("open"); });
})();
</script>
